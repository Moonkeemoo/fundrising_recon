# fundrising_recon — приклад змінних середовища.
# Скопіюй цей файл у .env і встав свої ключі. .env У GIT НЕ ПОТРАПЛЯЄ.
# Як дістати кожен ключ — див. docs/SETUP-KEYS.md.
# Будь-який порожній ключ → відповідне джерело просто пропускається (graceful-skip).

# --- YouTube Data API v3 (console.cloud.google.com) ---
YOUTUBE_API_KEY=

# --- Telegram (my.telegram.org → API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Meta Ad Library (developers.facebook.com; потрібне підтвердження особи) ---
META_ADS_TOKEN=

# --- Критик (прямий Anthropic API; навмисно НЕ ANTHROPIC_API_KEY) ---
# Потрібен лише для кроку верифікації критиком; екстракція йде на підписці без ключа.
FUNDREC_CRITIC_API_KEY=
